# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Optional. Without it the Location map uses OpenFreeMap's free, keyless planet tiles,
# which is a perfectly good production fallback. With it you get MapTiler's tiles and
# the style's {key} tokens are filled in at runtime.
VITE_MAPTILER_KEY=

# Required — phone OTP login (see src/features/auth/). Project Settings → API in
# your Supabase dashboard. VITE_-prefixed vars are bundled into the client, so only
# the anon key belongs here, never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development: in the Supabase dashboard under Authentication → Providers → Phone,
# add a test phone number with a fixed OTP (e.g. +911234567890 / 123456). Supabase
# accepts that OTP for that number without sending any SMS or costing anything —
# use it for local dev and QA instead of a real phone.

# Production only — server-side secrets for api/auth-send-sms-hook.js, the target
# of Supabase's "Send SMS" Auth Hook. Set these in Vercel's project env vars, NOT
# in this file and NEVER with a VITE_ prefix (that would ship them to the browser).
# See the setup notes at the top of api/auth-send-sms-hook.js.
#   SUPABASE_HOOK_SECRET=
#   MSG91_AUTHKEY=
#   MSG91_TEMPLATE_ID=
